# Supabase Postgres connection string (pooled — pgbouncer transaction mode).
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Supabase direct connection (session mode) — required for Prisma migrations,
# since the pooled transaction-mode connection can't run them.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# https://resend.com — used by EmailService.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AzaisAi <onboarding@resend.dev>"

# Google Gemini — used for generation calls.
GEMINI_API_KEY=""

# JWT auth
# JWT_ACCESS_TTL is how long a signed-in session lasts before the user has to
# log in again — there's no refresh-token flow, so this is the whole session
# lifetime. Kept long (30 days) so users aren't repeatedly bounced back to
# the login page; shorten this once a refresh-token flow exists.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="30d"

# Cloudinary — generated images/videos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Polar.sh subscription billing — https://polar.sh
# POLAR_SERVER: "sandbox" while testing against https://sandbox.polar.sh, "production" to go live.
POLAR_ACCESS_TOKEN=""
POLAR_SERVER="sandbox"
POLAR_WEBHOOK_SECRET=""
POLAR_STARTER_PRODUCT_ID=""
POLAR_PRO_PRODUCT_ID=""
POLAR_BUSINESS_PRODUCT_ID=""

# DEV-ONLY BYPASS: when "true", POST /billing/checkout skips the real Polar
# API call entirely and immediately grants the plan's credits + updates
# planTier, as if a real checkout had already succeeded. For demoing/testing
# without real POLAR_ACCESS_TOKEN/POLAR_WEBHOOK_SECRET. The UI shows a visible
# "test mode" banner whenever this is on. MUST be "false" (or unset) once
# real Polar credentials are configured — never set "true" in production.
DEV_SKIP_PAYMENT=false

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
