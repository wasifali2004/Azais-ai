// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum GenerationType {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  PENDING
  COMPLETE
  FAILED
}

enum CreditReason {
  SIGNUP_BONUS
  GENERATION_DEBIT
  GENERATION_REFUND
  TOPUP
  SUBSCRIPTION_RENEWAL
  ADMIN_ADJUSTMENT
  PROMPT_ENHANCEMENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Nullable: a user who signed up via Google has no password.
  passwordHash  String?
  // Set when the account was created (or linked) via Google sign-in.
  googleId      String?  @unique
  plan          PlanTier @default(FREE)
  creditBalance Int      @default(0)
  isVerified    Boolean  @default(false)
  // Set once the user completes a Polar checkout. polarSubscriptionId also
  // doubles as an idempotency key so a redelivered webhook can't re-grant
  // the same period's credits twice.
  polarCustomerId     String? @unique
  polarSubscriptionId String? @unique
  // Lazily reset in GenerationService.enhancePrompt() whenever more than 24h
  // has passed since dailyEnhanceResetAt — no cron job needed.
  dailyEnhanceCount   Int      @default(0)
  dailyEnhanceResetAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verificationCodes EmailVerificationCode[]
  creditTransactions CreditTransaction[]
  generations        Generation[]
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // bcrypt hash of the 6-digit code — never store it in plaintext.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model CreditTransaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       CreditReason
  generationId String?
  generation   Generation?  @relation(fields: [generationId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

model Generation {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         GenerationType
  model        String
  prompt       String
  settings     Json
  status       GenerationStatus @default(PENDING)
  creditsCost  Int
  outputUrl    String?
  // Technical failure detail — logs/debugging only, never returned to the client.
  errorMessage String?
  // Calm, human-readable message shown to the client on failure. Never
  // contains stack traces, provider names, or raw API error codes.
  userMessage  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  creditTransactions CreditTransaction[]

  @@index([userId, createdAt])
}

model Plan {
  id             String @id @default(cuid())
  name           String @unique
  monthlyCredits Int
  priceCents     Int
}
